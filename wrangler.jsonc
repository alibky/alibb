{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alibb",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "535b86f0-3672-458e-b72d-22688a45ae96","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4338236d9d5d426b8a9ca455c41b7f1b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
